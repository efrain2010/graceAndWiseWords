---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import { getDictionary } from '../i18n/utils';

export const prerender = true;

const locale = 'en' as const;
const dict = getDictionary(locale);
// Use build-time environment variable for prerendered pages
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || 'placeholder';
---

<BaseLayout title="lendalore — Retreats in Galicia" description="Discover magical reading retreats in Galicia, Spain. Inspired by Celtic heritage, ancient history, and the wisdom of the land." lang={locale}>
  <div class="font-sans bg-cream text-dark-text overflow-x-hidden">
    <Header locale={locale} />
    <Hero locale={locale} />
    <ContactSection locale={locale} turnstileSiteKey={turnstileSiteKey} />
    <Footer locale={locale} />
  </div>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</BaseLayout>
