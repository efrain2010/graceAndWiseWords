---
import { getDictionary } from '../i18n/utils';

interface Props {
  locale: 'en' | 'es' | 'gl';
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const heroDict = dict.hero;
---

<section id="hero" class="relative md:min-h-screen md:min-h-[96vh] flex items-center justify-center overflow-hidden">
  {/* Background image with parallax */}
  <div class="absolute inset-0 overflow-hidden pointer-events-none" id="parallax-container">
    <picture>
      <source
        type="image/webp"
        srcset="
          /images/hero-forest-640.webp 640w,
          /images/hero-forest-960.webp 960w,
          /images/hero-forest-1280.webp 1280w,
          /images/hero-forest-1920.webp 1920w,
          /images/hero-forest-2560.webp 2560w
        "
        sizes="100vw"
      />
      <img
        src="/images/hero-forest-1920.jpg"
        alt="Misty forest path with moss-covered logs"
        class="w-full h-full object-cover"
        loading="eager"
        id="parallax-bg"
      />
    </picture>
  </div>

  {/* Dark gradient overlay */}
  <div class="absolute inset-0 bg-gradient-to-b from-black/35 via-black/40 to-black/92 pointer-events-none"></div>

  {/* Content card */}
  <div
    class="relative z-10 max-w-[640px] mx-6 py-12 md:py-14 px-7 md:px-12 text-center text-cream bg-white/10 backdrop-blur-xl border border-white/20 rounded-lg shadow-2xl my-30 md:my-14"
  >
    <p class="m-0 mb-3.5 text-xs md:text-xs tracking-widest uppercase text-gold">
      {heroDict.eyebrow}
    </p>
    <h1 class="m-0 hero-title text-5xl md:text-7xl lg:text-8xl leading-tight lowercase">
      {heroDict.title}
    </h1>
    <p class="m-0 mt-3.5 font-serif text-sm md:text-base text-brown-lighter">
      {heroDict.subtitle}
    </p>

    <p class="m-0 mt-6 md:mt-7 text-base md:text-lg leading-relaxed text-cream-accent max-w-[520px] mx-auto">
      <span class="text-sm md:text-xs tracking-widest uppercase">{heroDict.description}</span>
    </p>

    <a
      href={heroDict.contactLink}
      class="inline-block mt-9 px-9 py-3.75 bg-gold text-deep-brown text-xs tracking-widest uppercase rounded-sm font-semibold hover:bg-gold-light transition-colors"
    >
      {heroDict.cta}
    </a>
  </div>
</section>

<style>
  section#hero {
    background: linear-gradient(to bottom, rgba(30, 21, 15, 0.35) 0%, rgba(30, 21, 15, 0.4) 55%, rgba(30, 21, 15, 0.92) 100%);
  }

  #parallax-container {
    will-change: transform;
  }

  #parallax-bg {
    will-change: transform;
  }

  .hero-title {
    font-family: "Lavishly Yours", serif;
    font-weight: normal;
    letter-spacing: 0.05em;
  }
</style>

<script>
  const parallaxContainer = document.getElementById('parallax-container');
  const parallaxBg = document.getElementById('parallax-bg');

  if (parallaxContainer && parallaxBg) {
    const heroSection = parallaxContainer.closest('section#hero');

    window.addEventListener('scroll', () => {
      const rect = heroSection?.getBoundingClientRect();
      const scrolled = window.scrollY;
      const elementOffset = scrolled + (rect?.top ?? 0);

      if(heroSection) {
        const heroSectionOffsetHeight= heroSection?.offsetHeight;
        if (scrolled < elementOffset + (heroSectionOffsetHeight ?? 0)) {
          const parallaxDistance = (scrolled - elementOffset) * 0.5;
          parallaxBg.style.transform = `translateY(${parallaxDistance}px)`;
        }
      }
    }, { passive: true });
  }
</script>
