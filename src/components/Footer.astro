---
import { getDictionary } from '../i18n/utils';

interface Props {
  locale: 'en' | 'es' | 'gl';
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const footerDict = dict.footer;
const currentYear = new Date().getFullYear();
---

<footer class="bg-deep-brown text-cream-accent px-5 md:px-20 py-11 flex flex-wrap justify-between gap-6 items-center">
  <div>
    <p class="m-0 font-serif text-lg text-cream">{footerDict.businessName}</p>
  </div>

  <div class="flex gap-3.5">
    {/* Instagram */}
    <a href="#" aria-label="Instagram" class="w-9.5 h-9.5 rounded-full border border-brown-muted flex items-center justify-center hover:border-gold transition-colors text-cream-accent">
      <svg viewBox="0 0 24 24" class="w-4 h-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
        <circle cx="17.5" cy="6.5" r="1.5" />
      </svg>
    </a>

    {/* Music note */}
    <a href="#" aria-label="Music" class="w-9.5 h-9.5 rounded-full border border-brown-muted flex items-center justify-center hover:border-gold transition-colors text-cream-accent">
      <svg viewBox="0 0 24 24" class="w-4 h-4" stroke="currentColor" stroke-width="1.5" fill="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18v-13l12-2v13M9 9l12-2" />
        <circle cx="6" cy="18" r="2" />
        <circle cx="18" cy="16" r="2" />
      </svg>
    </a>
  </div>

  <p class="m-0 text-xs text-brown-pale">
    {footerDict.copyright.replace('{year}', currentYear.toString())}
  </p>
</footer>
