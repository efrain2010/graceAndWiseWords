---
import { getDictionary } from '../i18n/utils';
import InstagramSvg  from './atoms/icons/instagram.svg';
import TiktokSvg  from './atoms/icons/tiktok.svg';

interface Props {
  locale: 'en' | 'es' | 'gl';
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const footerDict = dict.footer;
const currentYear = new Date().getFullYear();
---

<footer class="bg-deep-brown text-cream-accent px-5 md:px-20 py-11 grid grid-cols-3 gap-6 items-center">
  <div>
    <p class="m-0 font-serif text-lg text-cream">{footerDict.businessName}</p>
  </div>

  <div class="flex gap-3.5 justify-center">
    <a href="#" aria-label="Instagram" class="w-9.5 h-9.5 rounded-full border border-brown-muted flex items-center justify-center hover:border-gold transition-colors text-cream-accent">
      <InstagramSvg />
    </a>

    <a href="#" aria-label="TikTok" class="w-9.5 h-9.5 rounded-full border border-brown-muted flex items-center justify-center hover:border-gold transition-colors text-cream-accent">
      <span class="flex w-4 h-4">
        <TiktokSvg />
      </span>

    </a>
  </div>

  <div class="flex justify-end">
    <p class="m-0 text-xs text-brown-pale">
      {footerDict.copyright.replace('{year}', currentYear.toString())}
    </p>
  </div>
</footer>
