<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800">
  <!-- Dark weathered background -->
  <rect width="1200" height="800" fill="#2a1810"/>
  
  <!-- Wood texture with vertical planks -->
  <rect x="0" y="0" width="400" height="800" fill="#3a2820"/>
  <rect x="400" y="0" width="400" height="800" fill="#2a1810"/>
  <rect x="800" y="0" width="400" height="800" fill="#3a2820"/>
  
  <!-- Wood grain lines -->
  <line x1="0" y1="100" x2="1200" y2="100" stroke="#1a0800" stroke-width="2" opacity="0.3"/>
  <line x1="0" y1="200" x2="1200" y2="200" stroke="#1a0800" stroke-width="1" opacity="0.2"/>
  <line x1="0" y1="300" x2="1200" y2="300" stroke="#1a0800" stroke-width="2" opacity="0.3"/>
  <line x1="0" y1="400" x2="1200" y2="400" stroke="#1a0800" stroke-width="1" opacity="0.2"/>
  <line x1="0" y1="500" x2="1200" y2="500" stroke="#1a0800" stroke-width="2" opacity="0.3"/>
  <line x1="0" y1="600" x2="1200" y2="600" stroke="#1a0800" stroke-width="1" opacity="0.2"/>
  <line x1="0" y1="700" x2="1200" y2="700" stroke="#1a0800" stroke-width="2" opacity="0.3"/>
  
  <!-- Ivy/foliage on left side -->
  <ellipse cx="100" cy="150" rx="80" ry="120" fill="#1a4d2e" opacity="0.8"/>
  <ellipse cx="150" cy="250" rx="100" ry="130" fill="#0d3a1f" opacity="0.7"/>
  <ellipse cx="80" cy="400" rx="90" ry="110" fill="#1a4d2e" opacity="0.8"/>
  <ellipse cx="120" cy="600" rx="100" ry="120" fill="#0d3a1f" opacity="0.7"/>
  <ellipse cx="90" cy="750" rx="85" ry="100" fill="#1a4d2e" opacity="0.8"/>
  
  <!-- Ivy/foliage on right side -->
  <ellipse cx="1100" cy="180" rx="85" ry="125" fill="#0d3a1f" opacity="0.7"/>
  <ellipse cx="1050" cy="350" rx="95" ry="140" fill="#1a4d2e" opacity="0.8"/>
  <ellipse cx="1120" cy="550" rx="90" ry="115" fill="#0d3a1f" opacity="0.7"/>
  <ellipse cx="1080" cy="750" rx="100" ry="105" fill="#1a4d2e" opacity="0.8"/>
  
  <!-- Door rectangle in center -->
  <rect x="400" y="150" width="400" height="500" fill="#1a0f08" stroke="#0a0500" stroke-width="4"/>
  
  <!-- Door weathering -->
  <rect x="410" y="160" width="90" height="480" fill="#2a1810" opacity="0.4"/>
  <rect x="700" y="160" width="90" height="480" fill="#2a1810" opacity="0.4"/>
  <rect x="420" y="200" width="360" height="40" fill="#0a0500" opacity="0.5"/>
  <rect x="420" y="400" width="360" height="40" fill="#0a0500" opacity="0.5"/>
  
  <!-- Text overlay hint -->
  <text x="600" y="700" font-family="serif" font-size="32" fill="#8a7a63" text-anchor="middle" opacity="0.5">Weathered wood door framed by ivy</text>
</svg>
